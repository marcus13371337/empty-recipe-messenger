{
  "id": "messages-messenger",
  "name": "Messenger",
  "description": "Brings the person's Facebook Messenger chats into the messages module and sends through it.",
  "version": "0.3.0",
  "uses": [
    "messages"
  ],
  "connectors": [
    "messenger"
  ],
  "helperPrograms": {
    "messenger": {
      "title": "Messenger helper",
      "for": "Keeps your Messenger account connected, so your chats come into Messages and your replies go out.",
      "version": "0.2.0",
      "args": [],
      "signIn": {
        "url": "https://www.facebook.com/",
        "cookies": [
          "c_user",
          "xs",
          "datr"
        ]
      },
      "platforms": {
        "darwin-arm64": {
          "url": "https://github.com/marcus13371337/messenger-helper/releases/download/v0.2.0/messenger-helper-darwin-arm64",
          "sha256": "6735464ac52d9c9cc1f400bfe086243bc804cca59bd0c1e2d760e2d389aa0db0"
        },
        "darwin-x64": {
          "url": "https://github.com/marcus13371337/messenger-helper/releases/download/v0.2.0/messenger-helper-darwin-x64",
          "sha256": "6d69171cf7b7e8402fbf0eeb8c4cd1ad0768bb4e821dfcfe033225818c276d88"
        }
      }
    }
  },
  "jobs": [
    {
      "job": "sync",
      "timeout": "5m"
    },
    {
      "job": "send",
      "timeout": "5m"
    }
  ],
  "schedules": [
    {
      "job": "sync",
      "every": "5m",
      "catchUp": true
    },
    {
      "job": "send",
      "every": "1m",
      "catchUp": true
    }
  ],
  "triggers": [
    {
      "job": "sync",
      "connection": "messenger",
      "on": [
        "changed",
        "added",
        "removed"
      ]
    },
    {
      "job": "send",
      "collection": "messages/messages"
    }
  ],
  "actions": [
    {
      "function": "older",
      "title": "Fetch a conversation's earlier messages",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "conversation": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "account",
          "conversation",
          "before",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "function": "search",
      "title": "Search an account's messages",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "conversation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "account",
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "function": "attachment",
      "title": "Fetch an attachment",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "account",
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "function": "openAttachment",
      "title": "Open an attachment on the Mac",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "account",
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "function": "showAttachment",
      "title": "Show an attachment in the Finder",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "account",
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "function": "openConversation",
      "title": "Open a chat in Messenger",
      "input": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "conversation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "account",
          "conversation"
        ],
        "additionalProperties": false
      }
    }
  ]
}
