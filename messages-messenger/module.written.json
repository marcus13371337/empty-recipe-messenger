{
  "name": "Messenger",
  "description": "Brings the person's Facebook Messenger chats into the messages module and sends through it.",
  "settings": {
    "kept_days": {
      "type": "integer",
      "default": 30,
      "min": 1,
      "max": 3650
    },
    "chats": {
      "type": "integer",
      "default": 100,
      "min": 1,
      "max": 2000
    }
  },
  "sourceOf": "messages",
  "connectors": [
    "messenger"
  ],
  "helperPrograms": {
    "messenger": {
      "title": "Messenger helper",
      "for": "Keeps your Messenger account connected, so your chats come into Messages and your replies go out.",
      "version": "0.2.0",
      "args": [],
      "signIn": {
        "url": "https://www.facebook.com/",
        "cookies": [
          "c_user",
          "xs",
          "datr"
        ]
      },
      "platforms": {
        "darwin-arm64": {
          "url": "https://github.com/marcus13371337/messenger-helper/releases/download/v0.2.0/messenger-helper-darwin-arm64",
          "sha256": "6735464ac52d9c9cc1f400bfe086243bc804cca59bd0c1e2d760e2d389aa0db0"
        },
        "darwin-x64": {
          "url": "https://github.com/marcus13371337/messenger-helper/releases/download/v0.2.0/messenger-helper-darwin-x64",
          "sha256": "6d69171cf7b7e8402fbf0eeb8c4cd1ad0768bb4e821dfcfe033225818c276d88"
        }
      }
    }
  },
  "jobs": [
    {
      "job": "send",
      "timeout": "5m"
    },
    {
      "job": "sync",
      "timeout": "5m"
    }
  ],
  "schedules": [
    {
      "job": "send",
      "every": "1m",
      "catchUp": true
    },
    {
      "job": "sync",
      "every": "5m",
      "catchUp": true
    }
  ],
  "triggers": [
    {
      "job": "send",
      "collection": "messages/messages"
    },
    {
      "job": "sync",
      "connector": "messenger",
      "on": [
        "changed",
        "added",
        "removed"
      ]
    },
    {
      "job": "sync",
      "setting": "messages-messenger/kept_days"
    },
    {
      "job": "sync",
      "setting": "messages-messenger/chats"
    }
  ]
}
